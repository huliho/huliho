{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@huliho/web#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/crates/server/src/mail/sanitize.rs",
        "$TURBO_ROOT$/crates/server/tests/xss/**"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build", "build:storybook"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/crates/server/src/csp.txt"]
    }
  }
}
