    "keeps": ["expression("]
  },
  {
    "title": "event handlers in every casing are dropped",
    "payload": "<img src=\"https://cdn.example/a.png\" onerror=\"top.__x=1\" ONERROR=\"top.__x=1\" OnError=\"top.__x=1\" onError=\"top.__x=1\"><div ONCLICK=\"top.__x=1\" onmouseover=\"top.__x=1\" onMouseOver=\"top.__x=1\">x</div>",
    "keeps": ["src=\"https://cdn.example/a.png\"", "<div>x</div>"]
  },
  {
    "title": "the hostile body of a nested message is a body like any other",
