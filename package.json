{
  "name": "huliho",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^26.8.1",
    "pnpm": ">=11.24.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "oxlint --type-aware --deny-warnings && eslint --max-warnings 0 . && stylelint \"{apps,packages}/**/*.css\"",
    "typecheck": "tsc -b && turbo run typecheck",
    "build": "tsc -b && turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "knip": "knip",
    "size": "size-limit",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@size-limit/file": "^13.0.3",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jscpd": "^5.0.16",
    "knip": "^6.33.0",
    "lefthook": "^2.1.12",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "size-limit": "^13.0.3",
    "stylelint": "^17.14.1",
    "stylelint-plugin-logical-css": "^2.1.0",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "prettier": {
    "printWidth": 100
  },
  "stylelint": {
    "plugins": [
      "stylelint-plugin-logical-css"
    ],
    "rules": {
      "logical-css/require-logical-properties": [
        true,
        {
          "severity": "error"
        }
      ],
      "logical-css/require-logical-keywords": [
        true,
        {
          "severity": "error"
        }
      ]
    },
    "ignoreFiles": [
      "**/dist/**",
      "**/storybook-static/**",
      "**/node_modules/**"
    ]
  },
  "knip": {
    "ignore": [
      "apps/web/lighthouserc.cjs"
    ],
    "workspaces": {
      "packages/i18n": {
        "ignoreDependencies": [
          "@inlang/plugin-icu1"
        ]
      }
    }
  },
  "jscpd": {
    "threshold": 2,
    "minLines": 15,
    "gitignore": true,
    "ignore": [
      "**/OFL-*.txt"
    ],
    "reporters": [
      "console"
    ]
  },
  "size-limit": [
    {
      "name": "initial JS",
      "path": "apps/web/dist/assets/*.js",
      "limit": "250 kB",
      "gzip": true
    }
  ]
}
